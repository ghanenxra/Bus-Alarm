# Server Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Database (Use managed PostgreSQL for production; SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./bus_alarm.db
DATABASE_SYNC_URL=sqlite:///./bus_alarm.db

# Master Secret Key for token encryption at rest
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-string

# Device Registration Security
DEVICE_AUTH_ENABLED=true

# Polling Interval
DEFAULT_POLL_INTERVAL_SECONDS=10

# Firebase Cloud Messaging
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

