APP_NAME=Bus Alarm API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=d3654beda9b8ea48d4e0af680d30ac3bd8b5caa48dae60903e39281c9b7dc317
DEVICE_AUTH_ENABLED=true

# Database (Default async SQLite; for PostgreSQL use: postgresql+asyncpg://user:pass@host/dbname)
DATABASE_URL=sqlite+aiosqlite:///./bus_alarm.db
DATABASE_SYNC_URL=sqlite:///./bus_alarm.db

# Poller Configuration
DEFAULT_POLL_INTERVAL_SECONDS=10
MIN_POLL_INTERVAL_SECONDS=5
MAX_POLL_INTERVAL_SECONDS=60
POLLER_TIMEOUT_SECONDS=8.0

# CORS
CORS_ORIGINS=["*"]

# Provider Allowlist
ALLOWED_PROVIDER_HOSTS=["trackgps.blackbuck.com","gps.blackbuck.com","mock.busalarm.local"]

# Firebase Cloud Messaging (Optional)
FCM_ENABLED=false
